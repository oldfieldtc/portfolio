---
import {getCollection} from "astro:content";
import MainLayout from "../../layouts/MainLayout.astro";
import ArticleList from "../../components/ArticleList.astro";
import Pagination from "../../components/Pagination.astro";

export async function getStaticPaths({ paginate }) {
    const allArticles = await getCollection('articles');
    allArticles.sort((a,b) => a.data.pubDate.getTime() - b.data.pubDate.getTime()).reverse();

    return paginate(allArticles, { pageSize: 10 });
}

const { page } = Astro.props;
---
<MainLayout title="Articles - ">
    <h1>All posts</h1>
    { page.data.map(post => <ArticleList post={post} />) }
    <Pagination
        prevUrl={page.url.prev}
        nextUrl={page.url.next}
        currentUrl={page.url.current}
        currentPageNumber={page.currentPage}
        lastPageNumber={page.lastPage}
        firstUrl="/articles"
        lastUrl={`/articles/${page.lastPage}`}
        class="articles-pagination"
    />
</MainLayout>
