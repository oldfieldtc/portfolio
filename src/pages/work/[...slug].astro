---
import { CollectionEntry, getCollection, render } from 'astro:content';
import WorkContent from '../../layouts/WorkContent.astro';

export async function getStaticPaths() {
    const blogEntries = await getCollection('work');
    return blogEntries.map(entry => ({
        params: { slug: entry.data.slug }, props: { entry },
    }));
}

type Props = {
    entry: CollectionEntry<"work">;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---
<WorkContent frontmatter={ entry.data }>
    <Content />
</WorkContent>
