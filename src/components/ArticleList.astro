---
import type { CollectionEntry } from "astro:content";
import { formatDate } from "../scripts/utils";

import '../styles/article-list.css';

type Props = {
  post: CollectionEntry<"articles">
}

const { post }:
    {
        post: Props["post"]
    } = Astro.props;
const { title, description, pubDate, categories, external, slug }: {
    title?: string,
    description?: string,
    pubDate?: Date,
    categories?: string[],
    external?: {
        isExternal?: boolean,
        url?: string,
    },
    slug?: string
} = post.data;
const pathName: string = Astro.url.pathname;
const postURL: string = external.isExternal ? external.url : `/articles/${slug}`;
const TitleHeading: "h2" | "h3" = pathName === '/' ? "h3" : "h2";
---
<article class="article__list">
    <div class="article__content">
        <TitleHeading class="article__heading">
            <a href=`${postURL}`>{title}</a>
        </TitleHeading>

        <dl class="article__metadata">
            <dt>Published on</dt>
            <dd><time datetime={ pubDate.toISOString() }>{ formatDate(pubDate) }</time></dd>
        </dl>

        <p class="article__excerpt">{ description.split(" ").splice(0, 50).join(" ") }</p>
    </div>
  </article>
