---
import { getCollection, getEntry } from "astro:content";
import MainLayout from "../layouts/MainLayout.astro";
import Image from "../components/Image.astro";
import ArticleList from "../components/ArticleList.astro";
import Card from '../components/Card.astro';

const articles = await getCollection("articles");
articles.sort((a, b) => a.data.pubDate - b.data.pubDate).reverse();
const cards = [
	await getEntry('work', 'university-of-st-andrews'),
	await getEntry('work', 'cs50'),
	await getEntry('work', 'wavlength')
];
---

<MainLayout title="">
	<div class="home__about">
		<div class="home__profile">
			<h1>Hi, I'm Tommy Oldfield!</h1>
			<p>
				I'm a <strong>web developer</strong> from Dundee, Scotland, currently working for the <strong>University of St Andrews</strong>.<br>
				You can read more about me and my work, but stick around for articles about tutorials and tech.
			</p>
		</div>
		<Image className="home__headshot" filename="tommy-headshot" altText="Tommy Oldfield" />
	</div>

	<h2>Latest articles</h2>
	{
		articles.slice(0, 3).map(post => <ArticleList post={post} />)
	}

	<h2 id="work">Work</h2>
	<div class="work__grid">
		{
			cards.map(element => <Card content={element} collection="work" showDescription={false} heading="h3"/>)
		}
	</div>
</MainLayout>
