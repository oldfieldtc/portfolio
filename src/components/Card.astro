---
import {type CollectionEntry, type DataEntryMap} from "astro:content";
import Image from './Image.astro';
import '../styles/card.css';

// This might not work. My idea is to have a flexible component that can handle any content
// collection. Although it seems to work with the 'work' collection!
const { collection } = Astro.props;
interface Props <T extends keyof DataEntryMap>{
    collection: string
    content: CollectionEntry<T>
    heading: string
    showDescription: boolean
}

const { content, heading, showDescription } = Astro.props;
const { image, title, description, slug } = content.data;
const url: string = content.url ? content.url : `/${collection}/${slug}`;
const TitleHeading: string = heading;
---

<div class="card__tile">
    <div class="card__link">
        <a href={url}>
            <Image className="card__thumbnail" filename={image.filename} altText={image.alt} width="300px" height="200px" />
            <TitleHeading>{title}</TitleHeading>
        </a>
    </div>
    {
        showDescription && (
            <div class="card__description">
                <p>{description}</p>
            </div>
        )
    }
</div>
