---
import { CollectionEntry, getCollection, render } from 'astro:content';
import ArticleContent from '../../layouts/ArticleContent.astro';

export async function getStaticPaths() {
    const blogEntries = await getCollection('articles');
    return blogEntries.map((post) => ({
        params: { slug: post.data.slug },
        props: { post }
    }));
}

interface Props {
    post: CollectionEntry<"articles">;
}

const { post } = Astro.props;
const { Content } = await render(post);
---
<ArticleContent frontmatter={ post.data }>
    <Content />
</ArticleContent>
